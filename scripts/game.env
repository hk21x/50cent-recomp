# This game's values for the shared scripts in sdk/scripts (sdk/scripts/common.sh lists each and its default)
GAME_XBE=default.xbe
GAME_LOG=bulletproof            # GameInfo::log
GAME_TARGET=Bulletproof         # the add_xbe_image target in CMakeLists.txt
GHIDRA_PROJECT=bulletproof
SMOKE_PAD=scripts/pad/boot.txt  # title, New Game, Normal, no profile, the first mission (the alley) by about vblank 7200
SMOKE_MENU="5800 6100"    # the intro sequence movie (seq\S001.sfd, 3 draws a frame): only reached when the menu presses landed
SMOKE_SECS=150            # the alley from about 120 s
SOAK_PAD=scripts/pad/soak.py   # the boot route into the alley, then random play (fire, crouch, jump, grab, heal, pause)
